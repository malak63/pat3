#include <Wire.h>
#include <Servo.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ================= OLED =================
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// ================= SERVO =================
Servo actuator;
const int servoPin = 3;

// ================= TCS3200 =================
const int S0 = 4;
const int S1 = 5;
const int S2 = 6;
const int S3 = 7;
const int sensorOut = 8;

// ================= L298N =================
const int IN1 = 9;
const int IN2 = 10;
const int ENA = 11;

// ================= VARIABLES =================
int redValue;
int greenValue;
int blueValue;

int objectCount = 0;
int motorSpeed = 180;


// ================= SETUP =================
void setup() {

  Serial.begin(9600);

  // TCS3200
  pinMode(S0, OUTPUT);
  pinMode(S1, OUTPUT);
  pinMode(S2, OUTPUT);
  pinMode(S3, OUTPUT);
  pinMode(sensorOut, INPUT);

  // TCS3200 frequency scaling = 20%
  digitalWrite(S0, HIGH);
  digitalWrite(S1, LOW);

  // L298N
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(ENA, OUTPUT);

  // Servo
  actuator.attach(servoPin);
  actuator.write(90);

  // OLED
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED ERROR");
    while (1);
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);

  display.setCursor(0, 0);
  display.println("CONVEYOR SYSTEM");

  display.setCursor(0, 20);
  display.println("System Ready");

  display.display();

  delay(2000);

  // Start conveyor
  startMotor();
}


// ================= MAIN LOOP =================
void loop() {

  // Read colours
  redValue = readRed();
  greenValue = readGreen();
  blueValue = readBlue();

  // Determine colour
  String colour = detectColour();

  Serial.print("R: ");
  Serial.print(redValue);

  Serial.print(" G: ");
  Serial.print(greenValue);

  Serial.print(" B: ");
  Serial.println(blueValue);

  // Display information
  display.clearDisplay();

  display.setCursor(0, 0);
  display.println("CONVEYOR SYSTEM");

  display.setCursor(0, 15);
  display.print("Colour: ");
  display.println(colour);

  display.setCursor(0, 30);
  display.print("Count: ");
  display.println(objectCount);

  display.setCursor(0, 45);
  display.println("Belt: RUNNING");

  display.display();


  // Object detected
  if (colour != "NONE") {

    objectCount++;

    // Stop conveyor
    stopMotor();

    delay(500);


    // Move actuator
    if (colour == "RED") {

      actuator.write(30);
      delay(700);
      actuator.write(90);

    }

    else if (colour == "GREEN") {

      actuator.write(150);
      delay(700);
      actuator.write(90);

    }

    else if (colour == "BLUE") {

      actuator.write(60);
      delay(700);
      actuator.write(90);

    }

    delay(500);

    // Start conveyor again
    startMotor();

    // Show sorting information
    display.clearDisplay();

    display.setCursor(0, 0);
    display.println("OBJECT SORTED");

    display.setCursor(0, 20);
    display.print("Colour: ");
    display.println(colour);

    display.setCursor(0, 40);
    display.print("Total: ");
    display.println(objectCount);

    display.display();

    delay(1000);
  }

  delay(200);
}


// ================= MOTOR START =================
void startMotor() {

  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

  analogWrite(ENA, motorSpeed);
}


// ================= MOTOR STOP =================
void stopMotor() {

  analogWrite(ENA, 0);

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
}


// ================= READ RED =================
int readRed() {

  digitalWrite(S2, LOW);
  digitalWrite(S3, LOW);

  delay(50);

  return pulseIn(sensorOut, LOW);
}


// ================= READ GREEN =================
int readGreen() {

  digitalWrite(S2, HIGH);
  digitalWrite(S3, HIGH);

  delay(50);

  return pulseIn(sensorOut, LOW);
}


// ================= READ BLUE =================
int readBlue() {

  digitalWrite(S2, LOW);
  digitalWrite(S3, HIGH);

  delay(50);

  return pulseIn(sensorOut, LOW);
}


// ================= COLOUR DETECTION =================
String detectColour() {

  // No valid reading
  if (redValue == 0 ||
      greenValue == 0 ||
      blueValue == 0) {

    return "NONE";
  }


  // RED
  if (redValue < greenValue * 0.75 &&
      redValue < blueValue * 0.75) {

    return "RED";
  }


  // GREEN
  if (greenValue < redValue * 0.75 &&
      greenValue < blueValue * 0.75) {

    return "GREEN";
  }


  // BLUE
  if (blueValue < redValue * 0.75 &&
      blueValue < greenValue * 0.75) {

    return "BLUE";
  }


  return "NONE";
}
