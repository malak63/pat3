/*
  NC(V) Robotics and Industrial Automation - Level 4
  CBPIS Conveyor Belt Project

  Components:
  - Arduino Uno
  - TCS3200 Colour Sensor
  - L298N Motor Driver
  - DC Motor / Conveyor Belt
  - Servo Motor (Actuator)
  - I2C OLED Display

  PIN CONNECTIONS:
  TCS3200:
  S0  -> D4
  S1  -> D5
  S2  -> D6
  S3  -> D7
  OUT -> D8

  L298N:
  IN1 -> D9
  IN2 -> D10
  ENA -> D11

  Servo:
  Signal -> D3

  OLED:
  SDA -> A4
  SCL -> A5
*/

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <Servo.h>

// ---------------- OLED ----------------
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// ---------------- Servo ----------------
Servo actuator;

// ---------------- TCS3200 ----------------
const int S0 = 4;
const int S1 = 5;
const int S2 = 6;
const int S3 = 7;
const int sensorOut = 8;

// ---------------- Motor Driver ----------------
const int IN1 = 9;
const int IN2 = 10;
const int ENA = 11;

// ---------------- Variables ----------------
int redValue;
int greenValue;
int blueValue;

int objectCount = 0;

// Motor speed: 0 - 255
int motorSpeed = 180;


// =================================================
// SETUP
// =================================================
void setup()
{
  Serial.begin(9600);

  // Colour sensor pins
  pinMode(S0, OUTPUT);
  pinMode(S1, OUTPUT);
  pinMode(S2, OUTPUT);
  pinMode(S3, OUTPUT);
  pinMode(sensorOut, INPUT);

  // Set TCS3200 frequency scaling to 20%
  digitalWrite(S0, HIGH);
  digitalWrite(S1, LOW);

  // Motor pins
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(ENA, OUTPUT);

  // Servo
  actuator.attach(3);
  actuator.write(90);

  // Start OLED
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C))
  {
    Serial.println("OLED not found!");
    while (true);
  }

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.setCursor(0, 0);
  display.println("CBPIS CONVEYOR");
  display.setCursor(0, 15);
  display.println("System Starting...");
  display.display();

  delay(2000);

  display.clearDisplay();
  display.setCursor(0, 0);
  display.println("System Ready");
  display.display();

  delay(1000);

  // Start conveyor
  startConveyor();
}


// =================================================
// MAIN LOOP
// =================================================
void loop()
{
  // Read colour
  redValue = readRed();
  greenValue = readGreen();
  blueValue = readBlue();

  Serial.print("Red: ");
  Serial.print(redValue);

  Serial.print(" Green: ");
  Serial.print(greenValue);

  Serial.print(" Blue: ");
  Serial.println(blueValue);

  // Determine object colour
  String colour = detectColour();

  // Display information
  display.clearDisplay();

  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println("CBPIS CONVEYOR");

  display.setCursor(0, 15);
  display.print("Object: ");
  display.println(colour);

  display.setCursor(0, 30);
  display.print("Objects: ");
  display.println(objectCount);

  display.setCursor(0, 45);
  display.println("Belt: RUNNING");

  display.display();

  // If an object is detected
  if (colour != "NONE")
  {
    objectCount++;

    // Stop conveyor
    stopConveyor();

    delay(300);

    // Activate actuator depending on colour
    if (colour == "RED")
    {
      actuator.write(30);
      delay(700);
      actuator.write(90);
    }

    else if (colour == "GREEN")
    {
      actuator.write(150);
      delay(700);
      actuator.write(90);
    }

    else if (colour == "BLUE")
    {
      actuator.write(60);
      delay(700);
      actuator.write(90);
    }

    // Wait for servo to return
    delay(300);

    // Start conveyor again
    startConveyor();

    // Display sorting message
    display.clearDisplay();
    display.setTextSize(1);

    display.setCursor(0, 0);
    display.println("OBJECT SORTED");

    display.setCursor(0, 20);
    display.print("Colour: ");
    display.println(colour);

    display.setCursor(0, 40);
    display.print("Count: ");
    display.println(objectCount);

    display.display();

    delay(800);
  }

  delay(100);
}


// =================================================
// MOTOR FUNCTIONS
// =================================================

void startConveyor()
{
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

  analogWrite(ENA, motorSpeed);
}


void stopConveyor()
{
  analogWrite(ENA, 0);

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
}


// =================================================
// COLOUR SENSOR FUNCTIONS
// =================================================

int readRed()
{
  digitalWrite(S2, LOW);
  digitalWrite(S3, LOW);

  delay(50);

  return pulseIn(sensorOut, LOW);
}


int readGreen()
{
  digitalWrite(S2, HIGH);
  digitalWrite(S3, HIGH);

  delay(50);

  return pulseIn(sensorOut, LOW);
}


int readBlue()
{
  digitalWrite(S2, LOW);
  digitalWrite(S3, HIGH);

  delay(50);

  return pulseIn(sensorOut, LOW);
}


// =================================================
// COLOUR DETECTION
// =================================================

String detectColour()
{
  // Prevent invalid readings
  if (redValue == 0 || greenValue == 0 || blueValue == 0)
  {
    return "NONE";
  }

  /*
    TCS3200 normally gives a LOWER pulse period
    for a stronger colour.

    These values are starting values.
    They may need calibration for your sensor,
    lighting and objects.
  */

  if (redValue < greenValue * 0.75 &&
      redValue < blueValue * 0.75)
  {
    return "RED";
  }

  if (greenValue < redValue * 0.75 &&
      greenValue < blueValue * 0.75)
  {
    return "GREEN";
  }

  if (blueValue < redValue * 0.75 &&
      blueValue < greenValue * 0.75)
  {
    return "BLUE";
  }

  return "NONE";
}
