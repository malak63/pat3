#include <iostream>
#include <string>
using namespace std;

const int SIZE = 50; // maximum number of orders

// Parallel arrays
int orderID[SIZE];
string customerName[SIZE];
int numMagwinya[SIZE];
double totalAmount[SIZE];

int orderCount = 0; // number of current orders

// Function to add an order
void addOrder() {
    if (orderCount >= SIZE) {
        cout << "⚠ Cannot add more orders, storage is full!" << endl;
        return;
    }

    cout << "\nEnter details for new order:" << endl;
    cout << "Order ID: ";
    cin >> orderID[orderCount];
    cout << "Customer Name: ";
    cin >> customerName[orderCount];
    cout << "Number of Magwinyas: ";
    cin >> numMagwinya[orderCount];

    // Each Magwinya costs R5
    totalAmount[orderCount] = numMagwinya[orderCount] * 5.0;

    orderCount++;
    cout << "✅ Order added successfully!" << endl;
}

// Function to display all orders
void displayOrders() {
    if (orderCount == 0) {
        cout << "No orders found!" << endl;
        return;
    }

    cout << "\nMagwinya Magic Orders" << endl;
    cout << "-------------------------------------------" << endl;
    cout << "OrderID\tCustomer\tMagwinyas\tTotal (R)" << endl;
    cout << "-------------------------------------------" << endl;

    for (int i = 0; i < orderCount; i++) {
        cout << orderID[i] << "\t"
             << customerName[i] << "\t\t"
             << numMagwinya[i] << "\t\t"
             << totalAmount[i] << endl;
    }
    cout << "-------------------------------------------" << endl;
}

// Function to search for an order by ID
void searchOrder() {
    int searchID;
    cout << "Enter Order ID to search: ";
    cin >> searchID;

    for (int i = 0; i < orderCount; i++) {
        if (orderID[i] == searchID) {
            cout << "✅ Order found!" << endl;
            cout << "Order " << orderID[i] << " was placed by "
                 << customerName[i] << ", who ordered "
                 << numMagwinya[i] << " Magwinyas, totaling R"
                 << totalAmount[i] << "." << endl;
            return;
        }
    }
    cout << "⚠ Order with ID " << searchID << " not found!" << endl;
}

int main() {
    int choice;

    do {
        cout << "\n====== Magwinya Magic Order Management ======" << endl;
        cout << "1. Add New Order" << endl;
        cout << "2. Display All Orders" << endl;
        cout << "3. Search Order by ID" << endl;
        cout << "0. Exit" << endl;
        cout << "Choose an option: ";
        cin >> choice;

        switch (choice) {
            case 1: addOrder(); break;
            case 2: displayOrders(); break;
            case 3: searchOrder(); break;
            case 0: cout << "👋 Exiting system. Goodbye!" << endl; break;
            default: cout << "⚠ Invalid choice. Try again." << endl;
        }

    } while (choice != 0);

    return 0;
}
